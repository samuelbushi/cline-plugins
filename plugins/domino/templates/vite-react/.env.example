# Domino React App Environment Variables
# Copy this file to .env.local for local development

# Model API Endpoint
# Get this URL from Domino Model APIs page
VITE_MODEL_API_URL=https://your-domino.company.com/models/MODEL_ID/latest/model

# Do not put model API bearer tokens in VITE_* variables.
# Vite embeds VITE_* values into browser JavaScript.
# Keep MODEL_API_TOKEN server-side in Domino app settings or a backend proxy.

# Optional: Additional configuration
# VITE_APP_TITLE=My Domino App
# VITE_DEBUG=false
